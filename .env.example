# ---- LLM (OpenAI-compatible; Qwen by default) ----
# Qwen: https://dashscope.aliyuncs.com/compatible-mode/v1  model: qwen-plus / qwen-max
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus

# ---- Bitget Agent Hub (SDK) ----
# Analysis instance needs no key (public market data).
# Paper-trading instance uses a DEMO API key only (bitget.com/api-management).
BITGET_DEMO_API_KEY=
BITGET_DEMO_SECRET_KEY=
BITGET_DEMO_PASSPHRASE=

# ---- bitget-signal public MCP (no key) ----
SIGNAL_MCP_URL=https://datahub.noxiaohao.com/mcp

# ---- App ----
# Seed watchlist, comma-separated Bitget rToken symbols (verified format: R+TICKER+USDT, see docs/notes/rtoken-coverage.md)
WATCHLIST_SEED=RTSLAUSDT,RNVDAUSDT,RAAPLUSDT,RMSFTUSDT,RMETAUSDT
# When 1: endpoints never place real behavior beyond paper; missing-key paths fall back to demo data
DEMO_MODE=1
# Secret for /api/cron/* (Vercel Cron sends it as Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
